# Cargo build output
/target/
**/*.rs.bk

# Model conversion, all of it generated or downloaded by tools/model_conversion:
#   models/          the upstream Caffe weights, fetched by download_models.sh
#   caffe_pb2.py     generated from caffe.proto by protoc
#   ref_outputs.npz  reference tensors from the OpenCV Caffe importer
#   *_out/           the converted weights, copied into crates/wxscan-models
tools/model_conversion/models/
tools/model_conversion/caffe_pb2.py
tools/model_conversion/ref_outputs.npz
tools/model_conversion/onnx_out/
tools/model_conversion/tflite_out/

# Parity corpus generated by tools/parity/gen_scene.py
tools/parity/scenes/

__pycache__/
*.pyc
.venv/

.DS_Store

# Path overrides for cross-repository development, written by wxscan-dev/link.sh.
# Never committed: it names sibling checkouts that only exist on a dev machine,
# and cargo hard-errors when a path override points at a missing directory.
.cargo/config.toml
